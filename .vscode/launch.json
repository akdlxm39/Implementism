{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CMake 솔루션 디버깅",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "CMake: Build Solution",
      "windows": {
        "program": "${workspaceFolder}/build/solution.exe",
        "miDebuggerPath": "C:/mingw64/bin/gdb.exe"
      },
      "linux": {
        "program": "${workspaceFolder}/build/solution",
        "miDebuggerPath": "/usr/bin/gdb"
      }
    },
    {
      "name": "단일 파일 디버깅",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "C/C++: g++ build active file",
      "windows": {
        "program": "${workspaceFolder}/run.exe",
        "miDebuggerPath": "C:/mingw64/bin/gdb.exe"
      },
      "linux": {
        "program": "${fileDirname}/run",
        "miDebuggerPath": "/usr/bin/gdb"
      }
    }
  ]
}