{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Build Solution",
      "type": "shell",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "windows": {
        "command": "cmake",
        "args": ["-G", "MinGW Makefiles", "-B", "build", "-S", ".", ";", "cmake", "--build", "build"]
      },
      "linux": {
        "command": "cmake -B build -S . && cmake --build build"
      }
    },
    {
      "type": "cppbuild",
      "label": "C/C++: g++ build active file",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "windows": {
        "command": "C:/mingw64/bin/g++.exe",
        "args": [
          "-std=c++14", "-pedantic-errors", "-fdiagnostics-color=always", "-g",
          "${file}", "-o", "${workspaceFolder}/run.exe"
        ]
      },
      "linux": {
        "command": "/usr/bin/g++",
        "args": [
          "-std=c++14", "-pedantic-errors", "-fdiagnostics-color=always", "-g",
          "${file}", "-o", "${fileDirname}/run"
        ]
      }
    }
  ]
}